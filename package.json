{
  "name": "barni-pos",
  "private": true,
  "version": "1.0.2",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "concurrently \"npm.cmd run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm.cmd run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.0.1",
    "wrangler": "^4.125.0"
  },
  "build": {
    "appId": "com.barni.cafe",
    "productName": "برني كافيه",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "barni-pos-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "barni-cafe",
        "repo": "Barni-POS"
      }
    ]
  }
}